{
    "name": "redmaple/invoice-generator",
    "type": "project",
    "description": "RedMaple Invoice Generator — Multi-Tenant Invoicing & Billing SaaS Platform for Hostinger",
    "keywords": ["laravel", "invoicing", "saas", "livewire", "stripe", "paypal"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0|^12.0",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.5",
        "mpdf/mpdf": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
